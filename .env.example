# LLM Configuration for AI Twin (Optional API configs)
# Used specifically in src/app/api/chat/route.ts for the AI twin integration.

# API key for your OpenAI-compatible LLM gateway or provider. Never commit it.
LLM_API_KEY=""

# OpenAI-style base URL of that gateway, e.g. https://your-gateway.example.com/v1
# ("/chat/completions" is appended automatically; a full URL also works).
LLM_BASE_URL=""

# The model must support OpenAI `tools` (function calling). Defaults to gpt-6-luna.
AI_MODEL="gpt-6-luna"

# Resend contact form delivery
# Verify your sending domain in Resend first, then use an address on that domain.
RESEND_API_KEY="re_your_resend_api_key"
CONTACT_EMAIL_FROM="Portfolio Contact <hello@example.com>"
CONTACT_EMAIL_TO="hello@example.com,team@example.com"

# Hosted artifacts (src/app/api/artifacts) — publishes HTML reports/PRDs at
# https://nikunj.codenex.dev/artifacts/<slug>/<file>.html via Vercel Blob.
# Provision a Blob store in the Vercel dashboard (Storage tab) to get this token.
BLOB_READ_WRITE_TOKEN=""
# Long random shared secret. Generate with `openssl rand -hex 32`. The same
# value must be set in the hosted-html-report skill's local config so
# host-file.sh can authenticate its uploads.
ARTIFACT_UPLOAD_TOKEN=""

# Optional: client-IP header set by your proxy, for rate limiting when not on Vercel (e.g. cf-connecting-ip)
TRUSTED_PROXY_HEADER=
